{
  "name": "flowdini-spec",
  "version": "0.4.6",
  "description": "Markdown parser for flowdini specs: headings (levels 1-3) and Obsidian inline fields",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "markdown",
    "obsidian",
    "parser",
    "flowdini"
  ],
  "license": "MIT",
  "author": "Vitalii Vasilev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VasilevVitalii/flowdini-spec.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
